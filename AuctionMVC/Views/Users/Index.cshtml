@model UserIndexViewModel
@{
    ViewData["Title"] = "المستخدمون";
}

@await Component.InvokeAsync("PageHeader", new AuctionMVC.ViewComponents.PageHeaderModel
{
    Title = "إدارة المستخدمين",
    Subtitle = "مستخدمي المنصة والمزايدين",
    Icon = "bi-people",
    ActionLabel = "إنشاء مستخدم جديد",
    ActionUrl = Url.Action("Create", "Users"),
    ActionIcon = "bi-plus-lg"
})

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="text-muted fs-7">
        إجمالي المستخدمين: <span class="fw-800 text-foreground">@Model.TotalCount.ToString("N0")</span>
    </div>

    <form method="get" class="d-flex align-items-center gap-2">
        <div class="input-group input-group-sm" style="width: 260px">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="بحث بالاسم أو البريد أو الجوال..." />
            <button type="submit" class="btn btn-soft-secondary">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover admin-datatable mb-0" style="width:100%">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الجوال</th>
                        <th>تاريخ التسجيل</th>
                        <th>المزادات</th>
                        <th>المزايدات</th>
                        <th>الفوز</th>
                        <th class="no-sort">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state py-4">
                                    <div class="empty-icon"><i class="bi bi-people"></i></div>
                                    <h6>لا يوجد مستخدمون</h6>
                                    <p>لم يتم العثور على مستخدمين مطابقين.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle" style="width:2rem;height:2rem;font-size:0.7rem">
                                            @item.Initials
                                        </div>
                                        <span class="fw-bold">@item.Name</span>
                                    </div>
                                </td>
                                <td dir="ltr" class="text-start">@item.Email</td>
                                <td dir="ltr" class="text-start">@item.Phone</td>
                                <td class="text-muted fs-8">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-soft-info">@item.AuctionCount</span></td>
                                <td><span class="badge bg-soft-secondary">@item.BidCount</span></td>
                                <td><span class="badge bg-soft-warning">@item.WinnerCount</span></td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-soft-secondary btn-sm px-2 py-1" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-soft-danger btn-sm px-2 py-1"
                                                title="حذف"
                                                data-confirm-action="@Url.Action("Delete", "Users", new { id = item.Id })"
                                                data-confirm-method="POST"
                                                data-confirm-title="حذف المستخدم؟"
                                                data-confirm-message="سيتم حذف المستخدم نهائياً. قد تفشل العملية إذا كان مرتبطاً بمزادات أو مزايدات."
                                                data-confirm-icon="bi-trash"
                                                data-confirm-variant="danger"
                                                data-confirm-text="حذف نهائي"
                                                data-confirm-require-text="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var hasData = @(Model.Items.Count > 0 ? "true" : "false");
            if (!hasData) return;

            AuctionDataTables.init(".admin-datatable", {
                columnDefs: [{ targets: "no-sort", orderable: false }],
                order: [[0, "asc"]]
            });
        })();
    </script>
}


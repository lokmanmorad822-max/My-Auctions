@model UserFormViewModel
@{
    ViewData["Title"] = "تعديل المستخدم";
}

@await Component.InvokeAsync("PageHeader", new AuctionMVC.ViewComponents.PageHeaderModel
{
    Title = "تعديل المستخدم",
    Subtitle = Model.Name,
    Icon = "bi-pencil-square"
})

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="card">
            <div class="card-header">
                <i class="bi bi-person me-2"></i>بيانات المستخدم
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs-8 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" dir="ltr" />
                        <span asp-validation-for="Phone" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" dir="ltr" />
                        <span asp-validation-for="Email" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" dir="ltr" type="password" />
                        <div class="form-text">اتركه فارغاً لعدم تغيير كلمة المرور.</div>
                        <span asp-validation-for="Password" class="text-danger fs-8"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>حفظ التعديلات
                    </button>
                    <button type="button"
                            class="btn btn-soft-danger px-4"
                            data-confirm-action="@Url.Action("Delete", "Users", new { id = Model.Id })"
                            data-confirm-method="POST"
                            data-confirm-title="حذف المستخدم؟"
                            data-confirm-message="سيتم حذف المستخدم نهائياً. قد تفشل العملية إذا كان مرتبطاً بمزادات أو مزايدات."
                            data-confirm-icon="bi-trash"
                            data-confirm-variant="danger"
                            data-confirm-text="حذف نهائي"
                            data-confirm-require-text="حذف">
                        <i class="bi bi-trash me-1"></i>حذف المستخدم
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">إحصائيات</div>
            <div class="card-body">
                <div class="kv-row">
                    <span class="kv-key">تاريخ التسجيل</span>
                    <span class="kv-value">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


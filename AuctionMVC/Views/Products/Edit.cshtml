@model ProductFormViewModel
@{
    ViewData["Title"] = "تعديل المنتج";
}

@await Component.InvokeAsync("PageHeader", new AuctionMVC.ViewComponents.PageHeaderModel
{
    Title = "تعديل المنتج",
    Subtitle = Model.Name,
    Icon = "bi-pencil-square"
})

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="card">
            <div class="card-header">
                <i class="bi bi-box-seam me-2"></i>معلومات المنتج
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs-8 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label"></label>
                        <input asp-for="Category" class="form-control" list="categoryList" />
                        <datalist id="categoryList">
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                <option value="@cat"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Category" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Images" class="form-label"></label>
                        <input asp-for="Images" class="form-control" dir="ltr" />
                        <div class="form-text">روابط الصور مفصولة بفواصل.</div>
                        <span asp-validation-for="Images" class="text-danger fs-8"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>حفظ التعديلات
                    </button>
                    <button type="button"
                            class="btn btn-soft-danger px-4"
                            data-confirm-action="@Url.Action("Delete", "Products", new { id = Model.Id })"
                            data-confirm-method="POST"
                            data-confirm-title="حذف المنتج؟"
                            data-confirm-message="سيتم حذف المنتج نهائياً. تأكد من عدم ارتباطه بمزادات نشطة."
                            data-confirm-icon="bi-trash"
                            data-confirm-variant="danger"
                            data-confirm-text="حذف نهائي"
                            data-confirm-require-text="حذف">
                        <i class="bi bi-trash me-1"></i>حذف المنتج
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">معاينة الصورة الرئيسية</div>
            <div class="card-body text-center">
                @{
                    var firstImage = Model.Images?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault();
                }
                @if (!string.IsNullOrEmpty(firstImage))
                {
                    <img src="@firstImage" alt="@Model.Name" class="img-fluid rounded-3 border mb-2" style="max-height:180px;object-fit:cover" onerror="this.style.display='none'" />
                }
                else
                {
                    <div class="gradient-thumb mx-auto" style="width:8rem;height:8rem;border-radius:1rem">
                        <i class="bi bi-image"></i>
                    </div>
                }
                <div class="text-muted fs-8 mt-2">@Model.Name</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


@model AuctionDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل المزاد";
}

@await Component.InvokeAsync("PageHeader", new AuctionMVC.ViewComponents.PageHeaderModel
{
    Title = "تفاصيل المزاد",
    Subtitle = Model.ProductName,
    Icon = "bi-hammer"
})

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <!-- Hero -->
        <div class="card overflow-hidden mb-4">
            <div class="gradient-banner">
                <div class="position-absolute top-0 start-0 m-3">
                    <status-badge status="@Model.Status" />
                </div>
            </div>
            <div class="card-body">
                <div class="text-muted fs-8">@Model.Category</div>
                <h5 class="fw-900 mb-2">@Model.ProductName</h5>
                <p class="text-muted fs-7">@Model.Description</p>

                <div class="row g-3 mt-1 border-top pt-3">
                    <div class="col-6 col-md-3">
                        <div class="kv-row d-block">
                            <div class="kv-key mb-1">سعر البداية</div>
                            <div class="kv-value"><currency amount="@Model.StartPrice" /></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kv-row d-block">
                            <div class="kv-key mb-1">السعر الحالي</div>
                            <div class="kv-value text-primary fs-5"><currency amount="@Model.CurrentPrice" /></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kv-row d-block">
                            <div class="kv-key mb-1">عدد المزايدات</div>
                            <div class="kv-value">@Model.BidCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kv-row d-block">
                            <div class="kv-key mb-1">ينتهي في</div>
                            <div class="kv-value" data-countdown="@Model.EndDate.ToString("o")">@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bids -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-cash-coin me-2"></i>سجل المزايدات</span>
                <span class="badge bg-soft-secondary">@Model.BidCount مزايدة</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>المزايد</th>
                                <th>المبلغ</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bids.Count == 0)
                            {
                                <tr>
                                    <td colspan="3">
                                        <div class="empty-state py-4">
                                            <div class="empty-icon"><i class="bi bi-cash"></i></div>
                                            <h6>لا توجد مزايدات بعد</h6>
                                            <p>لم يقدم أي مستخدم مزايدة على هذا المزاد حتى الآن.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var bid in Model.Bids)
                                {
                                    <tr>
                                        <td class="fw-bold">@bid.BidderName</td>
                                        <td class="fw-bold text-primary"><currency amount="@bid.Amount" /></td>
                                        <td class="text-muted fs-8">@bid.CreatedAt.ToString("dd/MM/yyyy · HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-12 col-xl-4">
        <div class="card mb-4">
            <div class="card-header">معلومات</div>
            <div class="card-body">
                <div class="kv-row">
                    <span class="kv-key">المالك</span>
                    <span class="kv-value">@Model.OwnerName</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">تاريخ البدء</span>
                    <span class="kv-value">@Model.StartDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">الحالة</span>
                    <span class="kv-value"><status-badge status="@Model.Status" /></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">إجراءات</div>
            <div class="card-body d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>تعديل
                </a>

                @if (Model.Status == AuctionStatus.Pending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-soft-success btn-sm">
                            <i class="bi bi-check-lg me-1"></i>الموافقة
                        </button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-soft-danger btn-sm">
                            <i class="bi bi-x-lg me-1"></i>رفض
                        </button>
                    </form>
                }

                @if (Model.Status == AuctionStatus.Active)
                {
                    <button type="button"
                            class="btn btn-soft-gold btn-sm"
                            data-confirm-action="@Url.Action("Stop", "Auctions", new { id = Model.Id })"
                            data-confirm-method="POST"
                            data-confirm-title="إيقاف المزاد؟"
                            data-confirm-message="سيتم إيقاف المزاد نهائياً ولن يُسمح بإضافة مزايدات جديدة."
                            data-confirm-icon="bi-stop-circle"
                            data-confirm-variant="gold"
                            data-confirm-text="تأكيد الإيقاف">
                        <i class="bi bi-stop-circle me-1"></i>إيقاف المزاد
                    </button>
                }

                <button type="button"
                        class="btn btn-soft-danger btn-sm"
                        data-confirm-action="@Url.Action("Delete", "Auctions", new { id = Model.Id })"
                        data-confirm-method="POST"
                        data-confirm-title="حذف المزاد؟"
                        data-confirm-message="هذا الإجراء نهائي ولا يمكن التراجع عنه. سيتم حذف المزاد وسجل مزايداته بشكل دائم."
                        data-confirm-icon="bi-trash"
                        data-confirm-variant="danger"
                        data-confirm-text="حذف نهائي"
                        data-confirm-require-text="حذف">
                    <i class="bi bi-trash me-1"></i>حذف المزاد
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-trophy me-2"></i>الفائز
            </div>
            <div class="card-body">
                @if (Model.WinnerUserName is not null)
                {
                    <div class="gradient-card text-center py-3">
                        <div class="fs-6 fw-900">@Model.WinnerUserName</div>
                        <div class="fs-7 text-muted">فاز بمبلغ</div>
                        <div class="fs-5 fw-900 text-primary"><currency amount="@Model.WinnerFinalPrice.GetValueOrDefault()" /></div>
                    </div>
                }
                else
                {
                    <div class="text-muted fs-7">
                        يُحدَّد الفائز تلقائياً عند انتهاء المزاد وفق أعلى مزايدة.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}


@model AuctionFormViewModel
@{
    ViewData["Title"] = "تعديل المزاد";
}

@await Component.InvokeAsync("PageHeader", new AuctionMVC.ViewComponents.PageHeaderModel
{
    Title = "تعديل المزاد",
    Subtitle = $"تعديل مزاد # {Model.Id.ToString().Substring(0, 8)}",
    Icon = "bi-pencil-square"
})

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs-8 mb-3"></div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-person me-2"></i>المالك
                </div>
                <div class="card-body">
                    <select asp-for="UserId" asp-items="@(new SelectList(Model.AvailableUsers, "Id", "Name"))" class="form-select">
                        <option value="">— اختر المالك —</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger fs-8"></span>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-box-seam me-2"></i>المنتج
                </div>
                <div class="card-body">
                    <select asp-for="ProductId" asp-items="@(new SelectList(Model.AvailableProducts, "Id", "Name"))" class="form-select">
                        <option value="">— اختر المنتج —</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger fs-8"></span>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-gear me-2"></i>إعدادات المزاد
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartPrice" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="StartPrice" class="form-control" type="number" step="0.01" min="0.01" />
                                <span class="input-group-text">ر.س</span>
                            </div>
                            <span asp-validation-for="StartPrice" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CurrentPrice" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CurrentPrice" class="form-control" type="number" step="0.01" min="0" />
                                <span class="input-group-text">ر.س</span>
                            </div>
                            <span asp-validation-for="CurrentPrice" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="StartDate" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EndDate" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AuctionStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger fs-8"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>حالة المزاد
                </div>
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="text-muted fs-7">
                        لا يمكن تعديل السعر بعد تلقي أول مزايدة وفق قواعد النظام.
                    </div>
                    <status-badge status="@Model.Status" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-4">
                <div class="card-header">إجراءات</div>
                <div class="card-body d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>حفظ التعديلات
                    </button>

                    @if (Model.Status == AuctionStatus.Active)
                    {
                        <button type="button"
                                class="btn btn-soft-gold"
                                data-confirm-action="@Url.Action("Stop", "Auctions", new { id = Model.Id })"
                                data-confirm-method="POST"
                                data-confirm-title="إيقاف المزاد؟"
                                data-confirm-message="سيتم إيقاف المزاد نهائياً ولن يُسمح بإضافة مزايدات جديدة."
                                data-confirm-icon="bi-stop-circle"
                                data-confirm-variant="gold"
                                data-confirm-text="تأكيد الإيقاف">
                            <i class="bi bi-stop-circle me-1"></i>إيقاف المزاد
                        </button>
                    }

                    <button type="button"
                            class="btn btn-soft-danger"
                            data-confirm-action="@Url.Action("Delete", "Auctions", new { id = Model.Id })"
                            data-confirm-method="POST"
                            data-confirm-title="حذف المزاد؟"
                            data-confirm-message="هذا الإجراء نهائي ولا يمكن التراجع عنه. سيتم حذف المزاد وسجل مزايداته بشكل دائم."
                            data-confirm-icon="bi-trash"
                            data-confirm-variant="danger"
                            data-confirm-text="حذف نهائي"
                            data-confirm-require-text="حذف">
                        <i class="bi bi-trash me-1"></i>حذف المزاد
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">ملخص</div>
                <div class="card-body">
                    <div class="kv-row">
                        <span class="kv-key">الحالة</span>
                        <span class="kv-value">@Model.Status</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-key">سعر البداية</span>
                        <span class="kv-value"><currency amount="@Model.StartPrice" /></span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-key">السعر الحالي</span>
                        <span class="kv-value text-primary"><currency amount="@Model.CurrentPrice" /></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

